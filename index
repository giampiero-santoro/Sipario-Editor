<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<title>Sipario Editor — Editor professionale per copioni teatrali</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  :root {
    --sipario: #5C1A21;
    --sipario-dark: #3A1014;
    --oro: #B8923C;
    --oro-chiaro: #D9BE7E;
    --carta: #F3ECDD;
    --carta-scura: #E7DBC0;
    --inchiostro: #2A211B;
    --grigio: #83786A;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--sipario-dark); font-family: 'Inter', sans-serif;
    color: var(--inchiostro); height: 100vh; overflow: hidden; display: flex; flex-direction: column;
    transition: background 0.3s;
  }

  /* HEADER */
  header {
    background: linear-gradient(180deg, var(--sipario) 0%, var(--sipario-dark) 100%);
    padding: 15px 28px; border-bottom: 3px solid var(--oro); display: flex; align-items: center; justify-content: space-between;
    transition: margin-top 0.3s ease;
  }
  .header-hidden header { margin-top: -80px; }
  
  .brand { font-family: 'Playfair Display', serif; color: var(--oro-chiaro); font-size: 16px; font-weight: bold; text-transform: uppercase; }
  
  /* LAYOUT MAIN */
  .layout { display: flex; flex: 1; overflow: hidden; position: relative; }
  
  /* SIDEBAR */
  aside {
    width: 300px; background: var(--carta-scura); border-right: 1px solid #d6c7a1;
    display: flex; flex-direction: column; transition: margin-left 0.3s ease;
  }
  .sidebar-hidden aside { margin-left: -300px; }

  /* STAGE (FOGLIO) */
  main { flex: 1; display: flex; flex-direction: column; background: #4a1319; position: relative; overflow-y: auto; }
  .page {
    background: var(--carta); max-width: 700px; width: 95%; min-height: 80vh;
    margin: 40px auto; padding: 50px; box-shadow: 0 12px 40px rgba(0,0,0,.45);
    font-family: 'Courier Prime', monospace;
  }

  /* TOOLBAR FLOTTANTE */
  .floating-toolbar {
    position: fixed; right: 20px; top: 50%; transform: translateY(-50%);
    background: var(--carta); border: 2px solid var(--oro); border-radius: 8px;
    display: flex; flex-direction: column; gap: 8px; padding: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    z-index: 100; transition: transform 0.3s ease, right 0.3s ease;
  }
  .floating-toolbar button {
    background: var(--sipario); color: var(--carta); border: none; padding: 10px; border-radius: 6px;
    font-weight: bold; cursor: pointer; font-family: 'Inter', sans-serif;
  }
  .floating-toolbar button:hover { background: var(--sipario-dark); }
  
  /* TOGGLE BUTTONS (Nascondi UI) */
  .ui-toggles {
    position: absolute; top: 10px; left: 10px; z-index: 101; display: flex; gap: 5px;
  }
  .ui-toggles button {
    background: var(--carta-scura); border: 1px solid var(--oro); padding: 5px 10px; cursor: pointer; border-radius: 4px;
  }

  /* RESPONSIVE */
  @media(max-width: 820px) {
    aside { position: absolute; z-index: 200; height: 100%; margin-left: -300px; }
    .sidebar-open aside { margin-left: 0; }
    .floating-toolbar {
      top: auto; bottom: 20px; right: 50%; transform: translateX(50%);
      flex-direction: row; width: 90%; justify-content: center;
    }
    .page { margin-bottom: 100px; padding: 20px; }
  }

  /* FOCUS MODE */
  body.focus-mode header, body.focus-mode aside, body.focus-mode .ui-toggles { display: none !important; }
  body.focus-mode .floating-toolbar { opacity: 0.2; }
  body.focus-mode .floating-toolbar:hover { opacity: 1; }
</style>
</head>
<body>

<header>
  <div class="brand">🎭 Sipario Editor v2.0</div>
  <div style="color: white;">
    Titolo: <input type="text" value="Nuova Opera" style="background:transparent; color:white; border:none; border-bottom:1px solid var(--oro); outline:none;">
  </div>
</header>

<div class="layout">
  <aside>
    <div style="padding: 15px; border-bottom: 2px solid var(--oro);">
      <button style="width: 100%; padding: 10px; margin-bottom: 10px;">🆕 Nuovo copione</button>
      <button style="width: 100%; padding: 10px;">⚙️ Impostazioni Copyright</button>
    </div>
    <div style="padding: 15px; flex:1; overflow-y:auto; font-size: 14px;">
      <b>Atto I</b><br><br>
      Scena 1 - (Attiva)<br>
      Scena 2
    </div>
  </aside>

  <main>
    <div class="ui-toggles">
      <button onclick="document.body.classList.toggle('sidebar-hidden')">◀ Sidebar</button>
      <button onclick="document.body.classList.toggle('header-hidden')">☰ Header</button>
      <button onclick="document.body.classList.toggle('focus-mode')">👁 Focus Mode</button>
    </div>

    <div class="stage">
      <div class="page">
        <h3 style="text-align: center; color: var(--sipario); font-family: 'Playfair Display';">ATTO I</h3>
        <h4 style="text-align: center;">SCENA 1</h4>
        <p style="text-align: center; color: gray;">(Soggiorno, tramonto)</p>
        
        <p style="text-align: center; font-weight: bold; margin-top: 40px;">MARCO</p>
        <p style="text-align: center; width: 70%; margin: 0 auto;">Questa è una battuta di prova generata da Sipario Editor V2.0.</p>
        
        <p style="text-align: center; font-style: italic; width: 60%; margin: 20px auto; color: gray;">(Marco si siede sulla sedia di legno, pensieroso)</p>
      </div>
    </div>
  </main>

  <div class="floating-toolbar">
    <button title="Aggiungi Battuta">💬 + Battuta</button>
    <button title="Aggiungi Didascalia">🎬 + Didascalia</button>
    <button title="Aggiungi Fuori Scena">🔊 + Fuori scena</button>
    <button title="Aggiungi Nota di Regia">📝 + Nota</button>
  </div>
</div>

<script>
  let play = {
    title: "Nuova Opera",
    author: "Autore",
    acts: [
      {
        id: 'act1', title: 'Atto I',
        scenes: [{ id: 'sc1', title: 'Scena 1' }]
      }
    ]
  };

  document.querySelector('.floating-toolbar button:nth-child(1)').addEventListener('click', () => {
    alert("Funzionalità: Inserimento nuova battuta (Da collegare al motore del copione).");
  });
</script>
</body>
</html>
